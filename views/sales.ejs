<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Sales | NexaPulse Analytics</title>

    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >

    <link
        rel="stylesheet"
        href="/css/pages.css"
    >

</head>


<body>

<div class="app">


    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="brand">

            <div class="brand-icon">
                N
            </div>

            <div>

                <h2>NexaPulse</h2>

                <span>Analytics</span>

            </div>

        </div>


        <nav>

            <a href="/">
                <span>▦</span>
                Dashboard
            </a>


            <a href="/sales" class="active">
                <span>◫</span>
                Sales
            </a>


            <a href="/customers">
                <span>◉</span>
                Customers
            </a>


            <a href="/products">
                <span>▤</span>
                Products
            </a>


            <a href="/regions">
                <span>◌</span>
                Regions
            </a>


            <!-- ADMIN + ANALYST -->

            <% if (
                user &&
                (
                    user.role === "admin" ||
                    user.role === "analyst"
                )
            ) { %>

                <a href="/sales/new">

                    <span>＋</span>

                    Data Ingestion

                </a>

            <% } %>


            <!-- ADMIN ONLY -->

            <% if (
                user &&
                user.role === "admin"
            ) { %>

                <a href="/users">

                    <span>♙</span>

                    Users

                </a>

            <% } %>

        </nav>


        <div class="sidebar-bottom">


            <div class="system-status">

                <span class="status-dot"></span>

                <div>

                    <strong>System Online</strong>

                    <small>
                        Data updated today
                    </small>

                </div>

            </div>


            <a
                href="/logout"
                class="logout-button"
            >

                <span>↪</span>

                <span>Logout</span>

            </a>


        </div>

    </aside>


    <!-- MAIN CONTENT -->

    <main class="main">


        <!-- TOPBAR -->

        <header class="topbar">

            <div>

                <h1>Sales Overview</h1>

                <p>
                    Analyze sales transactions and revenue performance.
                </p>

            </div>


            <div class="top-actions">

                <div class="profile">

                    <% if (
                        user &&
                        user.fullName
                    ) { %>

                        <%= user.fullName
                            .split(" ")
                            .map(name => name[0])
                            .join("")
                            .substring(0, 2)
                            .toUpperCase()
                        %>

                    <% } else { %>

                        CA

                    <% } %>

                </div>

            </div>

        </header>


        <!-- KPI CARDS -->

        <section class="page-kpis">


            <div class="page-kpi">

                <span>
                    Total Revenue
                </span>

                <strong>

                    ₱<%= Number(
                        totalRevenue
                    ).toLocaleString() %>

                </strong>

            </div>


            <div class="page-kpi">

                <span>
                    Total Profit
                </span>

                <strong>

                    ₱<%= Number(
                        totalProfit
                    ).toLocaleString() %>

                </strong>

            </div>


            <div class="page-kpi">

                <span>
                    Total Orders
                </span>

                <strong>

                    <%= totalOrders %>

                </strong>

            </div>


            <div class="page-kpi">

                <span>
                    Average Order
                </span>

                <strong>

                    ₱<%= Number(
                        averageOrderValue
                    ).toLocaleString(
                        undefined,
                        {
                            maximumFractionDigits: 0
                        }
                    ) %>

                </strong>

            </div>


        </section>


        <!-- SALES TABLE -->

        <section class="table-panel">


            <div class="panel-header">


                <div>

                    <h3>
                        Sales Transactions
                    </h3>

                    <p>
                        Complete sales activity
                    </p>

                </div>


                <!-- ADMIN + ANALYST -->

                <% if (
                    user &&
                    (
                        user.role === "admin" ||
                        user.role === "analyst"
                    )
                ) { %>

                    <a
                        href="/sales/new"
                        class="action-button edit-button"
                    >

                        + Add Sale

                    </a>

                <% } %>


            </div>


            <div class="table-wrapper">


                <table>


                    <thead>

                        <tr>

                            <th>ID</th>

                            <th>Month</th>

                            <th>Customer</th>

                            <th>Region</th>

                            <th>Category</th>

                            <th>Product</th>

                            <th>Qty</th>

                            <th>Revenue</th>

                            <th>Profit</th>


                            <!-- ACTIONS ONLY FOR ADMIN + ANALYST -->

                            <% if (
                                user &&
                                (
                                    user.role === "admin" ||
                                    user.role === "analyst"
                                )
                            ) { %>

                                <th>
                                    Actions
                                </th>

                            <% } %>


                        </tr>

                    </thead>


                    <tbody>


                        <% sales.forEach(item => { %>


                            <tr>


                                <td>

                                    #<%= item.id %>

                                </td>


                                <td>

                                    <%= item.month %>

                                </td>


                                <td>

                                    <%= item.customer %>

                                </td>


                                <td>

                                    <%= item.region %>

                                </td>


                                <td>

                                    <span class="badge">

                                        <%= item.category %>

                                    </span>

                                </td>


                                <td>

                                    <%= item.product %>

                                </td>


                                <td>

                                    <%= item.quantity %>

                                </td>


                                <td>

                                    ₱<%= Number(
                                        item.revenue
                                    ).toLocaleString() %>

                                </td>


                                <td class="profit">

                                    ₱<%= Number(
                                        item.profit
                                    ).toLocaleString() %>

                                </td>


                                <!-- ADMIN + ANALYST ACTIONS -->

                                <% if (
                                    user &&
                                    (
                                        user.role === "admin" ||
                                        user.role === "analyst"
                                    )
                                ) { %>


                                    <td class="actions-cell">


                                        <!-- EDIT -->

                                        <a
                                            href="/sales/edit/<%= item.id %>"
                                            class="action-button edit-button"
                                        >

                                            Edit

                                        </a>


                                        <!-- ADMIN ONLY DELETE -->

                                        <% if (
                                            user.role === "admin"
                                        ) { %>


                                            <form
                                                action="/sales/delete/<%= item.id %>"
                                                method="POST"
                                                class="delete-form"
                                                onsubmit="return confirm('Are you sure you want to delete this sales record?');"
                                            >

                                                <button
                                                    type="submit"
                                                    class="action-button delete-button"
                                                >

                                                    Delete

                                                </button>

                                            </form>


                                        <% } %>


                                    </td>


                                <% } %>


                            </tr>


                        <% }) %>


                    </tbody>


                </table>


            </div>


        </section>


    </main>


</div>


</body>

</html>