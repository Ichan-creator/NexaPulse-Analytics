<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Customers | NexaPulse Analytics</title>

    <link
        rel="stylesheet"
        href="/css/dashboard.css"
    >

    <link
        rel="stylesheet"
        href="/css/pages.css"
    >

</head>


<body>

<div class="app">


    <aside class="sidebar">

        <div class="brand">

            <div class="brand-icon">
                N
            </div>

            <div>
                <h2>NexaPulse</h2>
                <span>Analytics</span>
            </div>

        </div>


        <nav>

            <a href="/">
                <span>▦</span>
                Dashboard
            </a>

            <a href="/sales">
                <span>◫</span>
                Sales
            </a>

            <a href="/customers" class="active">
                <span>◉</span>
                Customers
            </a>

            <a href="/products">
                <span>▤</span>
                Products
            </a>

            <a href="/regions">
                <span>◌</span>
                Regions
            </a>

        </nav>


        <div class="sidebar-bottom">

            <div class="system-status">

                <span class="status-dot"></span>

                <div>
                    <strong>System Online</strong>
                    <small>Data updated today</small>
                </div>

            </div>

            <a href="/logout" class="logout-button">

                <span>↪</span>
                <span>Logout</span>

            </a>
                
        </div>

    </aside>



    <main class="main">


        <header class="topbar">

            <div>

                <h1>Customers</h1>

                <p>
                    Understand customer activity and purchasing behavior.
                </p>

            </div>

        </header>



        <section class="page-kpis">

            <div class="page-kpi">

                <span>Total Customers</span>

                <strong>
                    <%= totalCustomers %>
                </strong>

            </div>

        </section>



        <section class="table-panel">

            <div class="panel-header">

                <div>

                    <h3>Customer Performance</h3>

                    <p>
                        Revenue and order activity by customer
                    </p>

                </div>

            </div>


            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>

                            <th>Customer</th>
                            <th>Orders</th>
                            <th>Units</th>
                            <th>Revenue</th>

                        </tr>

                    </thead>


                    <tbody>

                        <% customers.forEach(customer => { %>

                            <tr>

                                <td>
                                    <strong>
                                        <%= customer.name %>
                                    </strong>
                                </td>

                                <td>
                                    <%= customer.orders %>
                                </td>

                                <td>
                                    <%= customer.units %>
                                </td>

                                <td>
                                    ₱<%= Number(
                                        customer.revenue
                                    ).toLocaleString() %>
                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        </section>


    </main>

</div>

</body>
</html>